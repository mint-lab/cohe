---
import '../styles/global.css';
import Gates from '../components/Gates.astro';
import EffectPlot from '../components/EffectPlot.astro';
import { results, artifact, release, paper, source, number, bibtex } from '../data/results';
const base = import.meta.env.BASE_URL;
const title = 'COHE: Auditing Non-Transitivity in Sample Difficulty Proxies for Vision Models';
const description = 'COHE studies when sample difficulty scores predict learning and when they help data selection. NeurIPS 2026 Evaluations & Datasets.';
const canonical = Astro.site ? new URL(base, Astro.site).href : undefined;
const socialImage = canonical ? new URL('og-image.png', canonical).href : `${base}og-image.png`;
const navigation = [
  { href: '#framework', label: 'Framework' },
  { href: '#results', label: 'Results' },
  { href: '#reproducibility', label: 'Reproducibility' },
  { href: '#citation', label: 'Citation' },
];
const coverage = [
  ['CIFAR-100, ResNet-18', 'Training', 'Available', 'Available', '120', 'Dataset and score inputs required.'],
  ['CIFAR-100, ResNet-50', 'Training', 'Available', 'Available', 'Not retained', 'Second-learner results remain available.'],
  ['DINOv2 selection', 'Selection', 'Available', 'Available', 'Not retained', 'Scalar ranks and all reported conditions included.'],
  ['DDPM ordering', 'Ordering', 'Available', 'Available', '18 of 24', 'Random and Easy-to-Hard seeds 0–2 are missing.'],
  ['ImageNet-10', 'Scoring / fine-tuning', 'Available', 'Available', 'Not retained', 'Imagenette and score inputs required.'],
  ['ImageNet-1K VAE selection', 'Scoring / training', 'Available', 'Available', '20', 'ImageNet, VAE weights and training scores required.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · NeurIPS 2026</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="COHE" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="When does a sample difficulty proxy actually help? COHE compares dependence, prediction and transfer." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="When does a sample difficulty proxy actually help? COHE compares dependence, prediction and transfer." />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="nav-inner container">
        <a class="wordmark" href="#main" aria-label="COHE home">COHE</a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map(item => <a href={item.href}>{item.label}</a>)}
        </nav>
        <details class="mobile-nav" id="mobile-navigation">
          <summary>Menu</summary>
          <nav aria-label="Mobile navigation">
            {navigation.map(item => <a href={item.href}>{item.label}</a>)}
          </nav>
        </details>
      </div>
    </header>
    <main id="main" class="container">
      <header class="hero" aria-labelledby="hero-question">
        <h1 id="hero-question">When does a sample difficulty proxy actually help?</h1>
        <p id="paper-title" class="paper-title">{title}</p>
        <p class="venue">NeurIPS 2026 · Evaluations &amp; Datasets</p>
        <p class="authors">Dayena Jeong<sup>1</sup> and Sunglok Choi<sup>2</sup></p>
        <p class="university">Seoul National University of Science and Technology</p>
        <details class="affiliations">
          <summary>Affiliations</summary>
          <p><sup>1</sup> Department of Defense Artificial Intelligence Applications</p>
          <p><sup>2</sup> Department of Computer Science and Engineering</p>
        </details>
        <p class="hero-summary">
          DINOv2 predicts first-learning (ρ = {number(results.firstLearning.rho, 2)}), yet
          hard-sample selection returns {number(results.dino[0].delta, 1)} pp versus Random
          at {results.dino[0].label.replace(' subset', '')}.
        </p>
        <div class="hero-metrics" aria-label="DINOv2 evidence at three levels">
          <div><span>G1 — Dependence</span><strong>ρ = {number(results.firstLearning.rho, 4)}</strong><small>First-learning ranks</small></div>
          <div><span>G2 — Prediction</span><strong>R² = {number(results.firstLearning.r2, 4)}</strong><small>Held-out first-learning</small></div>
          <div><span>G3 — Selection</span><strong>{number(results.dino[0].delta)} <small>pp</small></strong><small>{results.dino[0].label.replace(' subset', '')} subset, test Top-1</small></div>
        </div>
        <nav class="hero-actions" aria-label="Paper resources">
          <a class="button" href={`${base}paper.pdf`}>Paper</a>
          <a class="button" href={artifact}>Code</a>
          <a class="button" href={release}>Checkpoints</a>
        </nav>
        <a class="conference-link" href={paper}>Conference record</a>
      </header>

      <section id="abstract" class="section overview" aria-labelledby="abstract-title">
        <h2 id="abstract-title">The study</h2>
        <p class="reading-width">
          Difficulty depends on what a model is asked to do. COHE separates agreement with a
          target, prediction on unseen samples, and the benefit of using a score in practice.
          Tests on vision benchmarks show that these forms of evidence can lead to different
          conclusions. The released code and results make each check inspectable.
        </p>
        <details class="abstract-details">
          <summary>Read the full abstract</summary>
          <p class="abstract reading-width">{results.abstract}</p>
        </details>
      </section>

      <Gates />

      <section id="results" class="section" aria-labelledby="results-title">
        <span id="findings" class="anchor-alias" aria-hidden="true"></span>
        <h2 id="results-title">Experimental results</h2>
        <p class="reading-width">Selection, ordering and retrieval test different uses of a difficulty score.</p>
        <article class="case-study">
          <div class="case-copy">
            <h3>DINOv2 hard-sample selection</h3>
            <p class="experiment-label">CIFAR-100, DINOv2 isolation</p>
            <p>Hard-only selection underperforms Random in every tested condition.</p>
            <p class="experiment-meta">
              ResNet-18, {results.dino.length} conditions with {results.dino[0].n} paired seeds
              each. Seed IDs are reused across conditions. Balanced selection uses balanced Random.
            </p>
            <a class="source-link" href={source(results.sources.dino)}>Seed records</a>
          </div>
          <div class="case-figure">
            <EffectPlot rows={results.dino} min={-20} max={0} ticks={[-20, -15, -10, -5, 0]} label="DINOv2 hard-selection differences versus matched Random" />
            <details class="seed-details">
              <summary>Mean accuracy and matched baselines</summary>
              <div class="table-scroll" tabindex="0" role="region" aria-label="DINOv2 accuracy table">
                <table>
                  <caption>DINOv2, Top-1 accuracy (%)</caption>
                  <thead><tr><th scope="col">Selection</th><th scope="col">Hard</th><th scope="col">Random</th></tr></thead>
                  <tbody>{results.dino.map(r => <tr><th scope="row">{r.label}</th><td>{number(r.hardMean)}</td><td>{number(r.randomMean)}</td></tr>)}</tbody>
                </table>
              </div>
            </details>
          </div>
        </article>
        <article class="case-study">
          <div class="case-copy">
            <h3>DDPM sample ordering</h3>
            <p class="experiment-label">CIFAR-100, DDPM difficulty scores</p>
            <p>Easy-to-Hard and Shuffled-Proxy Order both fall below global Random ordering.</p>
            <p class="experiment-meta">ResNet-18, {results.ddpm[0].n} paired seeds. Both blocked schedules use the same full data and optimizer step count.</p>
            <a class="source-link" href={source(results.sources.ddpm)}>Seed records</a>
          </div>
          <div class="case-figure">
            <EffectPlot rows={results.ddpm.slice(0, 2)} min={-1.4} max={0.4} ticks={[-1, -0.5, 0]} label="DDPM blocked-ordering differences versus global Random" />
            <div class="comparison-note">
              <span class="overline">Easy − Shuffled</span>
              <strong>{number(results.ddpm[2].delta)} <small>pp</small></strong>
              <span>95% CI [{number(results.ddpm[2].ci[0])}, {number(results.ddpm[2].ci[1])}]; paired p = {results.ddpm[2].p.toFixed(4)}</span>
            </div>
          </div>
        </article>
        <article class="case-study">
          <div class="case-copy">
            <h3>ImageNet-1K subset selection</h3>
            <p class="experiment-label">ImageNet-1K, VAE reconstruction scores</p>
            <p>Class-balanced VAE-hard selection underperforms balanced Random.</p>
            <p class="experiment-meta">ResNet-18 from scratch, {results.imagenet.best.n} matched seed pairs. Both arms use the same best-validation-Top-1 checkpoint rule.</p>
            <a class="source-link" href={source(results.sources.imagenet)}>Seed records</a>
          </div>
          <div class="case-figure">
            <figure class="accuracy-chart" aria-label="Mean ImageNet-1K best-checkpoint Top-1 accuracy">
              <div class="plot-key"><span>Best-checkpoint Top-1</span><span>Accuracy (%)</span></div>
              {[{label: 'Proxy-Hard', value: results.imagenet.best.hardMean}, {label: 'Random', value: results.imagenet.best.randomMean}].map((r, i) => (
                <div class="accuracy-row">
                  <div><span>{r.label}</span><strong>{number(r.value, 3)}%</strong></div>
                  <div class="accuracy-track"><span class={i === 0 ? 'hard-bar' : 'random-bar'} style={`width:${(r.value / 70) * 100}%`}></span></div>
                </div>
              ))}
              <div class="accuracy-axis"><span>0</span><span>35</span><span>70%</span></div>
              <figcaption>Mean accuracy across {results.imagenet.best.n} seeds. The interval below compares the paired difference.</figcaption>
            </figure>
            <div class="comparison-note">
              <span class="overline">Hard − Random</span>
              <strong>{number(results.imagenet.best.delta, 3)} <small>pp</small></strong>
              <span>95% CI [{number(results.imagenet.best.ci[0], 3)}, {number(results.imagenet.best.ci[1], 3)}]</span>
            </div>
            <details class="seed-details">
              <summary>Endpoint and evaluation details</summary>
              <p>VAE: stabilityai/sd-vae-ft-mse normalized-pixel reconstruction MSE. The largest scores are selected within each training class. Validation data is used for checkpoint selection and evaluation.</p>
              <p>Final-epoch sensitivity: {number(results.imagenet.final.delta, 3)} pp, 95% CI [{number(results.imagenet.final.ci[0], 3)}, {number(results.imagenet.final.ci[1], 3)}].</p>
            </details>
          </div>
        </article>
        <aside class="positive-control">
          <h3>Task-aligned retrieval</h3>
          <p class="reading-width">
            ResNet-18 CE retrieves <strong>{number(results.positive.gate3[0].recall * 100)}%</strong>
            of ResNet-50's target-hard samples at a top-{number(results.positive.gate3[0].q * 100, 0)}%
            budget, compared with {number(results.positive.gate3[0].q * 100, 0)}% expected under Random.
          </p>
          <a class="source-link" href={source(results.sources.positive)}>Control evidence</a>
        </aside>
        <div id="paper-figures" class="predictive-figure">
          <h3>Held-out predictive validity</h3>
          <figure class="paper-figure">
            <a href={`${base}figures/predictive-validity.svg`} aria-label="Open the predictive validity figure at full resolution">
              <img src={`${base}figures/predictive-validity.svg`} alt="Held-out R-squared for single and multi-proxy predictors. CE and margin are close to zero; first-learning has a larger value." loading="lazy" width="539.163375" height="203.372584" />
            </a>
            <figcaption>Prediction from generative proxy scores. Error bars show 95% confidence intervals over held-out splits.</figcaption>
          </figure>
        </div>
      </section>

      <section id="apply" class="section" aria-labelledby="apply-title">
        <h2 id="apply-title">Apply COHE</h2>
        <ol class="apply-steps reading-width">
          <li><strong>Choose the task.</strong> Specify the proxy, target, learner and intended use.</li>
          <li><strong>Check the evidence.</strong> Compare ranks, predict held-out targets and test the policy against a matched baseline.</li>
          <li><strong>Report what holds.</strong> State the supported claim and the setting in which it was tested.</li>
        </ol>
        <p class="reading-width">Verify the released statistics from completed experiment records in the artifact repository:</p>
        <pre><code>python scripts/reproduce.py --experiment paper_results</code></pre>
      </section>

      <section id="reproducibility" class="section" aria-labelledby="reproducibility-title">
        <h2 id="reproducibility-title">Reproducibility</h2>
        <p class="reading-width">The <a href={release}>v1.0-neurips2026 release</a> includes code, seven CIFAR-100 proxy arrays, aggregate and seed-level records, and 234 author-trained checkpoints.</p>
        <div class="table-scroll coverage-table" tabindex="0" role="region" aria-label="Experiment reproduction coverage">
          <table>
            <caption>Resources available for each experiment</caption>
            <thead><tr><th scope="col">Experiment</th><th scope="col">Code</th><th scope="col">Aggregates</th><th scope="col">Seeds</th><th scope="col">Checkpoints</th><th scope="col">Notes</th></tr></thead>
            <tbody>{coverage.map(row => <tr><th scope="row">{row[0]}</th>{row.slice(1).map(value => <td>{value}</td>)}</tr>)}</tbody>
          </table>
        </div>
        <p class="resource-note reading-width">CPU commands check released records. Regenerating scores and training models require upstream datasets, weights and experiment inputs; some historical source settings remain incomplete.</p>
        <a class="source-link" href={source('docs/REPRODUCIBILITY.md')}>Reproduction guide</a>
        <a class="source-link secondary-link" href={source('checkpoints/README.md')}>Checkpoint inventory</a>
      </section>

      <aside id="scope" class="section scope-box" aria-labelledby="scope-title">
        <h2 id="scope-title">Scope</h2>
        <ul>
          <li>Selection and ordering results concern the tested scores, learners, budgets and checkpoint rules. Other curricula, weighting methods and tasks were not evaluated.</li>
          <li>DINOv2's first-learning prediction and selection accuracy use different targets. First-learning and GradNorm signals are target-specific; scalar fits do not measure all information in a representation.</li>
          <li>The DDPM control does not distinguish harm from score–sample correspondence from the effect of blocked scheduling.</li>
          <li>The positive control tests retrieval, rather than retraining. The shaded near-zero band is descriptive, not a universal pass/fail threshold; a new audit must specify its criteria.</li>
        </ul>
      </aside>

      <section id="citation" class="section citation" aria-labelledby="citation-title">
        <div class="citation-heading"><h2 id="citation-title">Citation</h2><button type="button" id="copy-bibtex" class="button">Copy BibTeX</button></div>
        <span id="copy-status" role="status" aria-live="polite"></span>
        <pre><code id="bibtex">{bibtex}</code></pre>
      </section>
    </main>
    <footer class="site-footer container"><span>Dayena Jeong and Sunglok Choi</span><a href={artifact}>Scientific artifact</a></footer>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('#mobile-navigation');
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
      menu?.addEventListener('keydown', event => {
        if (event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); }
      });
      const button = document.querySelector<HTMLButtonElement>('#copy-bibtex');
      button?.addEventListener('click', async () => {
        const text = document.querySelector('#bibtex')?.textContent ?? '';
        const status = document.querySelector('#copy-status');
        try {
          await navigator.clipboard.writeText(text);
          if (status) status.textContent = 'Copied to clipboard.';
          button.textContent = 'Copied';
        } catch {
          const range = document.createRange();
          range.selectNodeContents(document.querySelector('#bibtex')!);
          const selection = window.getSelection();
          selection?.removeAllRanges(); selection?.addRange(range);
          if (status) status.textContent = 'Select and copy the highlighted citation.';
        }
      });
    </script>
  </body>
</html>
