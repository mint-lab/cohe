---
import { source } from '../data/results';
const gates = [
  { name: 'Dependence', question: 'Do the rankings agree?', explanation: 'Compare the proxy with the target on matched samples using Pearson r and Spearman ρ.' },
  { name: 'Prediction', question: 'Can it predict unseen samples?', explanation: 'Fit on the training split and measure R² on held-out target values.' },
  { name: 'Transfer', question: 'Does using the score help?', explanation: 'Compare the declared policy with a matched baseline, including uncertainty in the downstream metric.' },
];
const tiers = [
  ['Validated surrogate', 'All three gates pass for the stated target and protocol.'],
  ['Predictive validity only', 'G1 and G2 pass for the target, without a G3 pass.'],
  ['Target-specific relation', 'Relational evidence is confined to an auxiliary target, such as first-learning or GradNorm.'],
  ['Operational-only effect', 'G3 passes without both G1 and G2 passing for the same setting.'],
  ['Weak evidence', 'Support is incomplete or inconclusive, including agreement at G1 alone.'],
  ['No reliable transfer', 'G2 is measured weak or G3 has no reliable benefit, without matched positive G1 and G2 evidence.'],
];
const flow = `${import.meta.env.BASE_URL}figures/cohe-protocol-web.svg`;
---

<section id="framework" class="section framework" aria-labelledby="framework-title">
  <h2 id="framework-title">Three questions, three kinds of evidence</h2>
  <p class="reading-width">COHE checks how far a difficulty score can support a claim, one step at a time.</p>
  <ol class="gate-steps" aria-label="COHE evidence gates">
    {gates.map((gate, i) => (
      <li>
        <article>
          <span class="gate-label">G{i + 1} — {gate.name}</span>
          <h3>{gate.question}</h3>
          <p>{gate.explanation}</p>
        </article>
      </li>
    ))}
  </ol>
  <p class="evidence-note reading-width">
    The paper calls this <strong>non-transitivity</strong>: ranking agreement, held-out
    prediction and downstream benefit do not automatically imply one another.
  </p>
  <figure class="paper-figure protocol-figure">
    <a href={flow} aria-label="Open the COHE audit flow at full resolution">
      <img src={flow} alt="COHE checks a proxy, target and protocol for dependence, held-out prediction and operational transfer, then reports one of the six outcomes defined below." loading="lazy" width="1110" height="240" />
    </a>
    <figcaption>Audit flow with the paper’s six reporting outcomes. <a href={flow}>View at full size</a></figcaption>
  </figure>
  <div class="tier-legend" aria-labelledby="tiers-title">
    <h3 id="tiers-title">Six reporting outcomes</h3>
    <p class="reading-width">The paper groups audit reports into six tiers for the stated proxy, target and protocol.</p>
    <dl>
      {tiers.map(([name, meaning]) => <div><dt>{name}</dt><dd>{meaning}</dd></div>)}
    </dl>
    <p class="reading-width">An unmeasured gate is not a failure. A failed G3 preserves positive G1/G2 evidence; auxiliary-target relations retain their own label.</p>
    <a class="source-link" href={source('docs/CLAIM_TIER_GUIDE.md')}>Definitions and assignment order</a>
  </div>
</section>
