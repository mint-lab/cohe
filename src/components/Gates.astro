---
import { results, number } from '../data/results';
const gates = [
  { name: 'Dependence', question: 'Do the rankings agree?', explanation: 'Compare the proxy with the target on matched samples.', value: `ρ = ${number(results.firstLearning.rho, 4)}`, target: 'DINOv2, first-learning', boundary: 'Agreement alone does not establish prediction.' },
  { name: 'Prediction', question: 'Can it predict unseen samples?', explanation: 'Fit on one split and evaluate held-out target values.', value: `R² = ${number(results.firstLearning.r2, 4)}`, target: 'DINOv2, first-learning', boundary: 'Prediction alone does not show better selection.' },
  { name: 'Transfer', question: 'Does using the score help?', explanation: 'Test the policy against a matched baseline.', value: `${number(results.dino[0].delta)} pp`, target: `DINOv2, ${results.dino[0].label.replace(' subset', '')} selection`, boundary: 'A policy effect does not validate other uses of the proxy.' },
];
const flow = `${import.meta.env.BASE_URL}figures/cohe-protocol.svg`;
---

<section id="framework" class="section framework" aria-labelledby="framework-title">
  <h2 id="framework-title">Three questions, three kinds of evidence</h2>
  <p class="reading-width">COHE checks how far a difficulty score can support a claim, one step at a time.</p>
  <ol class="gate-steps" aria-label="COHE evidence gates">
    {gates.map((gate, i) => (
      <li>
        <article>
          <span class="gate-label">G{i + 1} — {gate.name}</span>
          <h3>{gate.question}</h3>
          <p>{gate.explanation}</p>
          <p class="gate-result"><strong>{gate.value}</strong><small>{gate.target}</small></p>
          <p class="gate-boundary">{gate.boundary}</p>
        </article>
      </li>
    ))}
  </ol>
  <figure class="paper-figure protocol-figure">
    <a href={flow} aria-label="Open the COHE audit flow at full resolution">
      <img src={flow} alt="COHE follows a proxy, target and protocol through dependence, held-out prediction and operational transfer, then reports a claim tier." loading="lazy" width="905.54" height="133.55" />
    </a>
    <figcaption><a href={flow}>View the audit flow</a></figcaption>
  </figure>
</section>
